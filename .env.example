# Copy this file to `.env` in the SAME folder as `package.json` (repo root).
# Vite also loads `srikanthphysics/.env` if present — keep one source of truth to avoid confusion.
# Never commit a real `.env` (it is gitignored).

# --- Supabase (required for the app) ---
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# --- Public site URL (emails, redirects, OAuth helpers) ---
# VITE_APP_URL=http://localhost:5175
# VITE_APP_URL=https://www.srikanthsacademy.com

# --- Daily Question Engine (FastAPI on Render, etc.) ---
# Local dev: leave unset and run `uvicorn` on port 8000 + `npm run dev` (Vite proxies /daily-engine-api).
#
# Vercel (recommended): server-only — admin UI uses /api/daily-engine → your engine host (any URL).
# DAILY_ENGINE_URL=https://daily-question-engine-xxx.vercel.app
#   (second Vercel project, root python/daily_question_engine) OR another host, e.g. onrender.com
#
# Optional: browser → Render directly (then set CORS_ORIGINS on Render to your site origins).
# VITE_DAILY_ENGINE_API=https://daily-question-engine.onrender.com

# --- AI keys (optional; used by several topic / generator flows) ---
# VITE_OPENAI_API_KEY=sk-proj-...
# VITE_ANTHROPIC_API_KEY=sk-ant-api03-...

# --- n8n webhooks (signup / signin / demo) ---
# VITE_N8N_WEBHOOK_URL=https://your-n8n.example/webhook/...
# VITE_N8N_SIGNUP_WEBHOOK_URL=
# VITE_N8N_SIGNIN_WEBHOOK_URL=

# --- RAG tutor (optional) ---
# VITE_RAG_API_URL=http://localhost:8000

# --- Payments (optional) ---
# VITE_RAZORPAY_KEY_ID=rzp_test_...
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# --- Demo / product webhook source (optional) ---
# VITE_PRODUCT_SOURCE=
