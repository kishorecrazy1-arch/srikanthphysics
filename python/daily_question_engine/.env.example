# Supabase Postgres (Settings → Database → URI). Direct connection recommended for SQLAlchemy.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# Anthropic (same family as your Node app)
ANTHROPIC_API_KEY=sk-ant-api03-...
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Comma-separated origins allowed to call this API from the browser (no spaces after commas).
# Local dev:
CORS_ORIGINS=http://localhost:5175,http://127.0.0.1:5175
# Production (add both www and apex if you use both):
# CORS_ORIGINS=https://www.srikanthsacademy.com,https://srikanthsacademy.com
